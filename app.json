{
  "expo": {
    "name": "TravelPal",
    "slug": "travelpal",
    "version": "0.1.0",
    "scheme": "travelpal",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelpal.app"
    },
    "android": {
      "package": "com.travelpal.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "TravelPal uses your photos to add pictures and receipts to a trip.",
          "cameraPermission": "TravelPal uses your camera to snap receipts and trip photos."
        }
      ]
    ]
  }
}
